    {
        "index_patterns": [
            "participant_changed-*"
        ],
        "template": {
            "settings": {
                "index": {
                    "lifecycle": {
                        "name": "participant_changed_policy",
                        "rollover_alias": "participant_changed_write"
                    },
                    "refresh_interval": "60s",
                    "number_of_shards": "1",
                    "translog": {
                        "flush_threshold_size": "2gb",
                        "sync_interval": "10s",
                        "durability": "async"
                    },
                    "merge": {
                        "scheduler": {
                            "max_thread_count": "1"
                        },
                        "policy": {
                            "max_merged_segment": "10gb"
                        }
                    },
                    "max_result_window": "50000",
                    "number_of_replicas": "0"
                }
            },
            "aliases": {
                "participant_changed_read": {}
            },
            "mappings": {
                "dynamic": "strict",
                "properties": {
                    "date": {
                        "format": "strict_date_optional_time||yyyy-MM-dd HH:mm:ss||epoch_millis",
                        "type": "date"
                    },
                    "id": {
                        "type": "long"
                    },
                    "id_group": {
                        "type": "keyword"
                    },
                    "participants_count": {
                        "type": "long"
                    }
                }
            }
        }
    }
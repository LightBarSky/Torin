{
    "index_patterns": [
        "gifts-*"
    ],
    "template": {
        "settings": {
            "index": {
                "lifecycle": {
                    "name": "gifts_policy",
                    "rollover_alias": "gifts_write"
                },
                "refresh_interval": "60s",
                "number_of_shards": "1",
                "translog": {
                    "flush_threshold_size": "2gb",
                    "sync_interval": "10s",
                    "durability": "async"
                },
                "merge": {
                    "scheduler": {
                        "max_thread_count": "1"
                    },
                    "policy": {
                        "max_merged_segment": "10gb"
                    }
                },
                "max_result_window": "50000",
                "number_of_replicas": "0"
            }
        },
        "aliases": {
            "gifts_read": {}
        },
        "mappings": {
            "dynamic": "strict",
            "properties": {
                "date": {
                    "format": "strict_date_optional_time||yyyy-MM-dd HH:mm:ss||epoch_millis",
                    "type": "date"
                },
                "id_gift": {
                    "type": "keyword"
                },
                "stars": {
                    "type": "long"
                },
                "convert_stars": {
                    "type": "long"
                },
                "id": {
                    "type": "long"
                },
                "id_from": {
                    "type": "keyword"
                },
                "id_group": {
                    "type": "keyword"
                },
                "message": {
                    "type": "text"
                },
                "title_gift": {
                    "type": "text"
                },
                "flags": {
                    "type": "text"
                },
                "flags2": {
                    "type": "text"
                },
                "availability_total": {
                    "type": "integer"
                }
            }
        }
    }
}
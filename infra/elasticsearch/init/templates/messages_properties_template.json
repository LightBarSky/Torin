{
    "index_patterns": [
        "messages_properties-*"
    ],
    "template": {
        "settings": {
            "index": {
                "lifecycle": {
                    "name": "delete_90d_policy"
                },
                "refresh_interval": "60s",
                "number_of_shards": "1",
                "translog": {
                    "flush_threshold_size": "2gb",
                    "sync_interval": "10s",
                    "durability": "async"
                },
                "merge": {
                    "scheduler": {
                        "max_thread_count": "1"
                    },
                    "policy": {
                        "max_merged_segment": "10gb"
                    }
                },
                "max_result_window": "50000",
                "number_of_replicas": "0"
            }
        },
        "aliases": {
            "messages_properties_read": {}
        },
        "mappings": {
            "dynamic": "strict",
            "properties": {
                "date": {
                    "format": "strict_date_optional_time||yyyy-MM-dd HH:mm:ss||epoch_millis",
                    "type": "date"
                },
                "edit_date": {
                    "format": "strict_date_optional_time||yyyy-MM-dd HH:mm:ss||epoch_millis",
                    "type": "date"
                },
                "created_at": {
                    "format": "strict_date_optional_time||yyyy-MM-dd HH:mm:ss||epoch_millis",
                    "type": "date"
                },
                "updated_at": {
                    "format": "strict_date_optional_time||yyyy-MM-dd HH:mm:ss||epoch_millis",
                    "type": "date"
                },
                "id_message": {
                    "type": "long"
                },
                "id": {
                    "type": "long"
                },
                "is_comments": {
                    "type": "keyword"
                },
                "id_group": {
                    "type": "keyword"
                },
                "id_from": {
                    "type": "keyword"
                },
                "grouped_id": {
                    "type": "keyword"
                },
                "identity_id": {
                    "type": "keyword"
                },
                "flags": {
                    "type": "text"
                },
                "flags2": {
                    "type": "text"
                },
                "has_text": {
                    "type": "boolean"
                },
                "has_media": {
                    "type": "boolean"
                },
                "media_type": {
                    "type": "keyword"
                },
                "media_value": {
                    "type": "object",
                    "enabled": false
                },
                "forwards": {
                    "type": "integer"
                },
                "is_forward": {
                    "type": "boolean"
                },
                "fwd_value": {
                    "type": "object",
                    "enabled": false
                },
                "views": {
                    "type": "integer"
                },
                "replies": {
                    "type": "integer"
                },
                "via_bot_id": {
                    "type": "keyword"
                },
                "via_business_bot_id": {
                    "type": "keyword"
                }
            }
        }
    }
}
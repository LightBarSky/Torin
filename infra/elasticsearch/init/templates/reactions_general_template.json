{
    "index_patterns": [
        "reactions_general-*"
    ],
    "template": {
        "settings": {
            "index": {
                "lifecycle": {
                    "name": "delete_90d_policy"
                },
                "refresh_interval": "60s",
                "number_of_shards": "1",
                "translog": {
                    "flush_threshold_size": "2gb",
                    "sync_interval": "10s",
                    "durability": "async"
                },
                "merge": {
                    "scheduler": {
                        "max_thread_count": "1"
                    },
                    "policy": {
                        "max_merged_segment": "10gb"
                    }
                },
                "max_result_window": "50000",
                "number_of_replicas": "0"
            }
        },
        "aliases": {
            "reactions_general_read": {}
        },
        "mappings": {
            "dynamic": "strict",
            "properties": {
                "date": {
                    "format": "strict_date_optional_time||yyyy-MM-dd HH:mm:ss||epoch_millis",
                    "type": "date"
                },
                "created_at": {
                    "format": "strict_date_optional_time||yyyy-MM-dd HH:mm:ss||epoch_millis",
                    "type": "date"
                },
                "updated_at": {
                    "format": "strict_date_optional_time||yyyy-MM-dd HH:mm:ss||epoch_millis",
                    "type": "date"
                },
                "reaction": {
                    "type": "keyword"
                },
                "count": {
                    "type": "long"
                },
                "id_message": {
                    "type": "long"
                },
                "id": {
                    "type": "long"
                },
                "id_group": {
                    "type": "keyword"
                },
                "is_comments": {
                    "type": "keyword"
                }
            }
        }
    }
}
{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Grpc": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.log",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "withMachineName",
      "WithThreadId"
    ]
  },
  "heartbeat": {
    "serviceName": "TelegramApiService",
    "topicName": "service-heartbeat"
  },
  "dbService": {
    "BaseUrl": ""
  },
  "guiService": {
    "BaseUrl": ""
  },
  "metrics":{
    "EndPoint": ""
  },
  "Kafka":{
    "BootstrapServers": "kafka:29092",
    "Topics": {
      "reactions": "reactions",
      "reactions_general": "reactions_general",
      "user": "user",
      "messages": "messages",
      "messages_properties": "messages_properties",
      "messages_entities": "messages_entities",
      "chat": "chat",
      "admin_chats": "admin_chats",
      "gifts": "gifts",
      "task_chats": "task_chats",
      "word_group_all": "word_group_all",
      "logs_handlers": "logs_handlers"
    }
  },
  "Parse":{
    "DaysDelayMessage": 1, 
    "DaysDelayParseUser": 3,
    "BatchForKafka": 50,
    "BatchForUser": 100,
    "TotalDetectPrivate": 4,
    "TotalSendRequest": 20,
    "DelayResolveUsernameS": 200,
    "DelayGetFullChatS": 1,
    "DelayLoaderGroupS": 300,
    "DelayUpdateGroupH": 4,
    "DelayParseGiftsMS": 1500,
    "DelayParseMessageMS": 1500,
    "DelayParseRepliesMS": 1500,
    "DelayJoinChannelS": 10,
    "DelayRestartM": 1440,
    "CountMessagesParseOnChat": 30000,
    "ParseMessage": true,
    "ParseMessageOnMessages": true,
    "ParseMessageOnProperties": true,
    "ParseMessageOnEntities": true,
    "ParseMessageOnReactions": true,
    "ParseMessageOnReactionsGeneral": true,
    "ParseMessageOnUsers": true,
    "ParseMessageRubikonDays": 60,
    "ParseUser": true,
    "ParseGifts": true
  },
  "Paths": {
    "Sessions": "/app/AppData/sessions",
    "AccessHashes": "/app/AppData/AccessHashes"
  }
}